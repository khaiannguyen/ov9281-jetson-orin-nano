// SPDX-License-Identifier: GPL-2.0-only
/*
 * tegra234-p3767-camera-p3768-ov9281-dual.dts
 *
 * Overlay 2x Waveshare OV9281-120 (cam0/cam1) trên Jetson Orin Nano,
 * board P3768 22-pin CSI connector.
 *
 * NGUỒN THAM CHIẾU: hardware/nvidia/t23x/nv-public/overlay/
 * tegra234-p3767-camera-p3768-imx219-dual.dts (R39.2, IMX219 dual — ĐANG
 * CHẠY ỔN trên chính board này, xác nhận CSI PHY/ISP/toolchain đều đúng).
 *
 * KHÁC BIỆT SO VỚI BẢN GỐC IMX219 (đã cân nhắc, xem thêm ghi chú trong
 * tegra234-camera-ov9281-dual.dtsi):
 *  - #include file .dtsi mới (ov9281, không phải rbpcv2-imx219).
 *  - Đổi tên node instance rbpcv2_imx219_a@10 / _c@10 -> ov9281_a@60 /
 *    ov9281_c@60 (địa chỉ I2C 7-bit mặc định OV9281 = 0x60, khác IMX219
 *    0x10 — xem OV9281_DEFAULT_I2C_ADDRESS_C0 trong nv_ov9281_ported_
 *    partial.c).
 *  - GIỮ NGUYÊN i2c-mux-gpio (cam_i2cmux) + CAM_I2C_MUX pin — dùng lại
 *    ĐÚNG cơ chế IMX219 dùng để tách cam0/cam1 thành 2 bus I2C logic riêng
 *    (route qua GPIO mux, không phải 2 controller I2C vật lý riêng biệt).
 *    ⚠️ LƯU Ý SỬA LẠI CÁCH HIỂU so với OV9281-Jetson-Project-Plan.md: quyết
 *    định trước đó ghi "2 bus I2C vật lý riêng" — sau khi đọc code .dts thật
 *    của IMX219 (baseline đang chạy trên board này), xác nhận cơ chế thật
 *    là i2c-mux-gpio (1 controller vật lý + GPIO mux tạo 2 bus con logic),
 *    KHÔNG phải 2 controller I2C vật lý tách biệt. Về mặt phần mềm/driver,
 *    kết quả tương đương những gì dự án cần (2 struct i2c_client/i2c_adapter
 *    riêng, cùng địa chỉ 0x60 không đụng độ vì mux route riêng từng bus con)
 *    — không cần sửa gì ở tầng driver .c, chỉ cần sửa lại mô tả cho ĐÚNG
 *    trong tài liệu dự án.
 *  - CAM0_PWDN/CAM1_PWDN: DÙNG LẠI đúng 2 chân GPIO IMX219 dùng (TEGRA234_
 *    MAIN_GPIO(H,6) và TEGRA234_MAIN_GPIO(AC,0)) làm reset-gpios (XSHUTDOWN)
 *    cho OV9281 — vì đây là chân điều khiển của CARRIER BOARD (đầu nối
 *    22-pin CSI), không phụ thuộc loại sensor cắm vào cam0/cam1.
 *    ✅ ĐÃ VERIFY THẬT trên board (2026-08-28, không còn là suy luận từ file
 *    nguồn tĩnh nữa): dump device tree ĐANG CHẠY thật qua
 *    `sudo dtc -I fs /proc/device-tree -O dts -o /tmp/current_running.dts`,
 *    đọc property `reset-gpios` thật trên node `rbpcv2_imx219_a@10`/`_c@10`:
 *      cam0: reset-gpios = <0xf4 0x3e 0x00>  -> phandle 0xf4 = main GPIO
 *            controller (gpio@2200000, xác nhận qua "compatible =
 *            nvidia,tegra234-gpio"); pin 0x3e = 62 = 7*8+6 = port H offset 6
 *            = TEGRA234_MAIN_GPIO(H,6)  <-- KHỚP giá trị đã dùng.
 *      cam1: reset-gpios = <0xf4 0xa0 0x00>  -> pin 0xa0 = 160 = 20*8+0 =
 *            port AC offset 0 = TEGRA234_MAIN_GPIO(AC,0)  <-- KHỚP.
 *      (tiện thể verify luôn mux-gpios trên cam_i2cmux đang chạy thật:
 *      <0x106 0x13 0x00> -> phandle 0x106 = AON GPIO controller, pin 19 =
 *      2*8+3 = port CC offset 3 = TEGRA234_AON_GPIO(CC,3) <-- khớp
 *      CAM_I2C_MUX bên dưới).
 *    Kết luận: 2 chân GPIO reset không còn là "mượn tạm/suy luận" — đã xác
 *    nhận bằng chính device tree thật đang chạy trên phần cứng, đúng như
 *    lý luận "chân của carrier board, không phụ thuộc sensor". Mục treo
 *    "GPIO reset (XSHUTDOWN)" trong PROGRESS-SUMMARY.md coi như đã đóng.
 *  - CAM0_RST (hog output-low) GIỮ NGUYÊN không đổi — chân phần cứng cấp
 *    board, không phụ thuộc loại sensor gắn vào.
 */

/dts-v1/;
/plugin/;

#define CAM0_RST	TEGRA234_MAIN_GPIO(H, 3)
#define CAM0_PWDN	TEGRA234_MAIN_GPIO(H, 6)
#define CAM1_PWDN	TEGRA234_MAIN_GPIO(AC, 0)
#define CAM_I2C_MUX	TEGRA234_AON_GPIO(CC, 3)

#include <dt-bindings/tegra234-p3767-0000-common.h>
#include "tegra234-camera-ov9281-dual.dtsi"

/ {
	overlay-name = "Camera OV9281 Dual";
	jetson-header-name = "Jetson 22pin CSI Connector";
	compatible = JETSON_COMPATIBLE_P3768;

	fragment-camera-ov9281@0 {
		target-path = "/";
		__overlay__ {
			bus@0 {
				cam_i2cmux {
					status = "okay";
					compatible = "i2c-mux-gpio";
					#address-cells = <1>;
					#size-cells = <0>;
					i2c-parent = <&cam_i2c>;
					mux-gpios = <&gpio_aon CAM_I2C_MUX GPIO_ACTIVE_HIGH>;
					i2c@0 {
						status = "okay";
						reg = <0>;
						#address-cells = <1>;
						#size-cells = <0>;
						ov9281_a@60 {
							reset-gpios = <&gpio CAM0_PWDN GPIO_ACTIVE_HIGH>;
						};
					};
					i2c@1 {
						status = "okay";
						reg = <1>;
						#address-cells = <1>;
						#size-cells = <0>;
						ov9281_c@60 {
							reset-gpios = <&gpio CAM1_PWDN GPIO_ACTIVE_HIGH>;
						};
					};
				};
				gpio@2200000 {
					camera-control-output-low {
						gpio-hog;
						output-low;
						gpios = <CAM0_RST 0>;
						label = "cam0-rst";
					};
				};
			};
		};
	};
};
